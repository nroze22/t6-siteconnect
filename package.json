{
  "name": "talos-siteconnect",
  "version": "1.0.0",
  "description": "On-premise patient screening desktop application for clinical research sites.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "vitest run && playwright test",
    "test:report": "node scripts/zephyr-reporter.mjs",
    "test:validate": "vitest run --coverage && node scripts/zephyr-reporter.mjs"
  },
  "author": "Talosix",
  "license": "UNLICENSED",
